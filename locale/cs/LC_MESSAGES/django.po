#  Czech overrides for strings Django itself has not translated.
#
#  Everything in here is a *Django* msgid, not app copy — the app's own text is
#  hardcoded Czech in the source. These are the leftovers: strings added to
#  Django recently enough that the `cs` catalogs it ships have no entry for
#  them, so `LANGUAGE_CODE = 'cs'` leaves them in English. LOCALE_PATHS puts
#  this catalog ahead of Django's own, which is the supported way to patch them.
#
#  After editing this file you MUST recompile it — the runtime reads only the
#  compiled .mo, and both are committed:
#
#      python manage.py compilemessages -l cs --ignore=.venv
#
#  Keep the --ignore: compilemessages walks the whole tree from the project
#  root, and without it recompiles every .po inside the virtualenv too.
#
#  To find newly-untranslated strings after a Django upgrade, render the admin
#  and look for English, or check a msgid with:
#
#      from django.utils.translation import gettext as _; _('some msgid')
#
msgid ""
msgstr ""
"Project-Id-Version: MaterialInventory\n"
"Report-Msgid-Bugs-To: \n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: cs\n"
"Plural-Forms: nplurals=3; plural=(n==1) ? 0 : (n>=2 && n<=4) ? 1 : 2;\n"

