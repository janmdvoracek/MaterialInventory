# Production environment — LAN-only deployment. See DEPLOYMENT.md.
#
# Copy to `.env.production` on the server and fill in. The filled-in file is
# gitignored and must never be committed; it is also excluded from the Docker
# image by .dockerignore.
#
# Pass it to every compose command, or APP_PORT and the DB credentials expand
# empty:
#   docker compose --env-file .env.production -f docker-compose.prod.yml <cmd>
#
# Avoid a literal `$` in any value here. Compose interpolates this file, so a
# `$` starts a variable reference (escape it as `$$` if you must). The
# SECRET_KEY generator below only ever emits [A-Za-z0-9_-], so it is safe.

# --- Django ------------------------------------------------------------------

# Generate per deploy, never reuse the dev key:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

DEBUG=False

# The server's reserved LAN IP first — that is the address everyone bookmarks.
# 127.0.0.1/localhost are kept so you can curl the app from the server itself
# while debugging; a host that is missing here answers 400 DisallowedHost.
ALLOWED_HOSTS=192.168.1.50,127.0.0.1,localhost

# Stays empty for this deployment: over plain HTTP Django compares the request's
# Origin against its own host, so ALLOWED_HOSTS is all CSRF needs. It becomes
# required the moment something terminates TLS in front of Django — a reverse
# proxy or a tunnel. See docs/configuration.md.
CSRF_TRUSTED_ORIGINS=

# --- Compose (read by docker-compose.prod.yml, not by Django) ----------------

# Publish only on the LAN interface. Docker's published ports bypass ufw, so
# 0.0.0.0 here means "reachable from wherever this server is reachable from".
# Set it to the same reserved LAN IP as above.
APP_BIND_IP=192.168.1.50

# Host port. Not 80/443/8000 — check `sudo ss -tlnp | grep LISTEN` first, the
# server already runs another web app.
APP_PORT=8080

# --- Gunicorn ----------------------------------------------------------------

# Gunicorn reads this natively. Its own default is 1 worker, which serializes
# every request: one wide-date-range report would block everyone else's page.
WEB_CONCURRENCY=3

# --- Database ----------------------------------------------------------------

# Deliberately not the dev values. Nothing outside the Compose network can
# reach this database, but a shared password across environments is still how
# a dev laptop ends up connected to production.
DB_NAME=materialinventory_prod
DB_USER=materialinventory_prod
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
