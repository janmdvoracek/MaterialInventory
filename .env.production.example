# Production environment — public deployment on a VPS, behind the company
# domain over HTTPS. See DEPLOYMENT.md.
#
# Copy to `.env.production` on the server and fill in. The filled-in file is
# gitignored and must never be committed; it is also excluded from the Docker
# image by .dockerignore.
#
# Pass it to every compose command, or the domain and the DB credentials expand
# empty:
#   docker compose --env-file .env.production -f docker-compose.prod.yml <cmd>
#
# Avoid a literal `$` in any value here. Compose interpolates this file, so a
# `$` starts a variable reference (escape it as `$$` if you must). The
# SECRET_KEY generator below only ever emits [A-Za-z0-9_-], so it is safe.

# --- Django ------------------------------------------------------------------

# Generate per deploy, never reuse the dev key:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

DEBUG=False

# The domain users type. 127.0.0.1/localhost are kept so you can curl the app
# from inside the container while debugging; a host that is missing here answers
# 400 DisallowedHost. Note this is the *Host header*, so it carries no scheme.
ALLOWED_HOSTS=inventar.firma.cz,127.0.0.1,localhost

# Required now, and the single most likely thing to be forgotten. Caddy
# terminates TLS and talks plain HTTP to Django, so the browser sends
# `Origin: https://inventar.firma.cz` while Django — reached over HTTP — expects
# `http://...`. They differ by scheme and **every POST fails 403 "Origin
# checking failed"**, login included, while every page still loads normally.
# Entries carry the scheme. ALLOWED_HOSTS does not fix this; the two settings
# are unrelated checks.
CSRF_TRUSTED_ORIGINS=https://inventar.firma.cz

# --- HTTPS -------------------------------------------------------------------
#
# All four are read by config/settings.py and default to OFF there, because the
# test suite runs with DEBUG=False and a global SECURE_SSL_REDIRECT would turn
# every test request into a 301. Production is where they get switched on.

# Django's own redirect. Caddy already redirects :80 to :443, so this is the
# second of two belts — it also catches anything that reaches gunicorn over
# HTTP by another route.
SECURE_SSL_REDIRECT=True

# Sets SESSION_COOKIE_SECURE and CSRF_COOKIE_SECURE together. Correct only over
# HTTPS: on a plain-HTTP deployment these stop both cookies being sent at all
# and nobody can log in.
SECURE_COOKIES=True

# HSTS max-age in seconds. Start at one hour and leave it there until a renewal
# has actually happened (~60 days), then raise to 31536000 (a year).
#
# This is the one setting that cannot be undone by editing this file: a browser
# that has seen the header refuses plain HTTP for this host for the full
# duration regardless of what the server later says. A year of that on a domain
# whose certificate has broken is a year of an unreachable site.
SECURE_HSTS_SECONDS=3600

# Safe as written *because the app is on a subdomain*: it covers
# inventar.firma.cz and anything beneath it, and does not reach firma.cz. If you
# ever move the app to the apex domain, set this to False unless the company has
# decided that every one of its subdomains is HTTPS-only forever.
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# --- Compose and Caddy (not read by config/settings.py) ----------------------

# The domain Caddy requests a certificate for. Must already resolve to this
# server's public IP before the first `up` — Caddy proves control of it over
# port 80, and a wrong or unresolved name means no certificate.
APP_DOMAIN=inventar.firma.cz

# ACME account address. Let's Encrypt mails it if renewal stops working, which
# is the one alert about this deployment worth receiving. Use a real, monitored
# mailbox — not a personal address that leaves with the person.
ACME_EMAIL=it@firma.cz

# --- Gunicorn ----------------------------------------------------------------

# Gunicorn reads this natively. Its own default is 1 worker, which serializes
# every request: one wide-date-range report would block everyone else's page.
WEB_CONCURRENCY=3

# --- Database ----------------------------------------------------------------

# Deliberately not the dev values. Nothing outside the Compose network can
# reach this database, but a shared password across environments is still how
# a dev laptop ends up connected to production.
DB_NAME=materialinventory_prod
DB_USER=materialinventory_prod
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
