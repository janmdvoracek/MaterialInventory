# Production environment. Copy to `.env.production` on the server and fill in;
# never commit it. See docs/deployment/DEPLOYMENT.md.
#
# Pass it to every compose command:
#   docker compose --env-file .env.production -f docker-compose.prod.yml <cmd>
#
# Avoid a literal `$` in values: Compose interpolates this file (escape as `$$`).

# --- Django ------------------------------------------------------------------

# Generate one per deploy:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

DEBUG=False

# Host names only, no scheme. localhost is kept for debugging inside the container.
ALLOWED_HOSTS=inventar.firma.cz,127.0.0.1,localhost

# With the scheme. Without it every POST, login included, fails 403
# "Origin checking failed" while pages still load.
CSRF_TRUSTED_ORIGINS=https://inventar.firma.cz

# --- HTTPS -------------------------------------------------------------------

SECURE_SSL_REDIRECT=True

# Secure session and CSRF cookies. HTTPS only, or nobody can log in.
SECURE_COOKIES=True

# Browsers enforce HSTS for the full duration, even if HTTPS later breaks. Keep
# one hour until a certificate renewal has happened, then raise to 31536000.
SECURE_HSTS_SECONDS=3600

# Safe on a subdomain. At the apex domain it would cover every company subdomain.
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# --- Compose and Caddy -------------------------------------------------------

# Must already resolve to this server before the first `up`, or no certificate.
APP_DOMAIN=inventar.firma.cz

# Let's Encrypt writes here if renewal fails. Use a monitored shared mailbox.
ACME_EMAIL=it@firma.cz

# Log the real client IP (from X-Forwarded-For) in django-axes, not the proxy's.
BEHIND_PROXY=True

# --- Gunicorn ----------------------------------------------------------------

# Gunicorn's default of 1 worker serializes every request.
WEB_CONCURRENCY=3

# --- Database ----------------------------------------------------------------

# Not the dev values.
DB_NAME=materialinventory_prod
DB_USER=materialinventory_prod
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
