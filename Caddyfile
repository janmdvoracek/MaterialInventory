# Reverse proxy and TLS for the production stack. Bind-mounted, so edits need
# only `up -d proxy`, not a rebuild.
#
# Caddy issues and renews the certificate itself, as long as port 80 stays open
# and the `caddy_data` volume survives (Let's Encrypt allows 5 certificates per
# hostname per week).
#
# `{$NAME}` is Caddy's env-var syntax; the values come from .env.production.

{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	# Caddy overwrites X-Forwarded-*, which is what makes SECURE_PROXY_SSL_HEADER
	# safe, as long as this is the only route to gunicorn.
	reverse_proxy web:8000

	encode zstd gzip

	# OPTIONAL, and a second layer rather than the only one: the app already
	# 404s /admin/ for anyone not logged in as an admin
	# (accounts/middleware.py::AdminSessionRequiredMiddleware). This restricts
	# the prefix to known addresses on top of that — replace the `reverse_proxy`
	# line above with this block (`route` keeps the order written).
	#
	# route {
	# 	@admin_denied {
	# 		path /admin/*
	# 		not remote_ip 203.0.113.4 198.51.100.0/24
	# 	}
	# 	respond @admin_denied 403
	# 	reverse_proxy web:8000
	# }
}
