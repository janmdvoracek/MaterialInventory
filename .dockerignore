# `COPY . .` runs before collectstatic, so anything under static/ here goes public.

.git
.github
.gitignore
.pre-commit-config.yaml

.venv
venv
__pycache__
*.pyc
*.egg-info
.ruff_cache
.coverage
htmlcov

# Secrets.
.env
.env.production

# Real company data; only the templates belong in the image.
seed_data/*.csv
!seed_data/*.example.csv

staticfiles/

# MEDIA_ROOT. Uploaded photos live in a volume; baking a developer's into the
# image would ship company data and be overwritten by the mount anyway.
media/

backups/

# Not served assets.
static/xlsx/

.claude
.vscode*
.DS_Store
db.sqlite3

# `*.md` matches the root only, hence docs/.
*.md
docs/

# Bind-mounted into the proxy instead.
Caddyfile
