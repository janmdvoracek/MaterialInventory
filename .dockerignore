# The Dockerfile's `COPY . .` runs before `collectstatic`, so anything left in
# the build context under static/ gets published at a public /static/ URL.
# Keep the context to what the app actually needs to run.

.git
.github
.gitignore

.venv
venv
__pycache__
*.pyc
*.egg-info
.ruff_cache

# Real secrets — must never be baked into an image layer.
.env
.env.production

# Real company data; only the .example.csv templates belong in the image.
seed_data/*.csv
!seed_data/*.example.csv

# Regenerated by the collectstatic build step.
staticfiles/

# Database dumps from scripts/backup_db.sh. They live inside the deployment
# checkout, so without this every `up -d --build` on the server would copy the
# whole backup history into an image layer.
backups/

# Working files that live under static/ but are not served assets.
static/xlsx/

.claude
.vscode*
.DS_Store
db.sqlite3

# Documentation — not needed at runtime. `*.md` only matches the context root,
# so docs/ needs listing separately.
*.md
docs/

# Reverse-proxy config. Bind-mounted into the `proxy` service from the server
# checkout, never needed inside the app image.
Caddyfile
