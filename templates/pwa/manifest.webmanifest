{% load static %}{% comment %}
The web app manifest, rendered by workorders/pwa.py::manifest. A template
rather than a file under static/ so the icon URLs go through {% static %} and
come out hashed in production like every other asset, and start_url through
{% url %}.

theme_color is the light-scheme `theme-color` meta in base.html, which is
--chrome-bg in app.css; PwaTests holds the two together. The manifest has one
theme_color, so the dark-scheme meta in base.html is what a dark phone shows
once the page has loaded.
{% endcomment %}{
    "id": "{% url 'transform_create' %}",
    "name": "VyrobaPK",
    "short_name": "VyrobaPK",
    "description": "Evidence zpracování materiálu, hodin a strojů",
    "lang": "cs",
    "dir": "ltr",
    "start_url": "{% url 'transform_create' %}",
    "scope": "/",
    "display": "standalone",
    "orientation": "portrait",
    "background_color": "#ffffff",
    "theme_color": "#1a1a1a",
    "icons": [
        {"src": "{% static 'img/icon-192.png' %}", "sizes": "192x192", "type": "image/png", "purpose": "any"},
        {"src": "{% static 'img/icon-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "any"},
        {"src": "{% static 'img/icon-maskable-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
    ]
}
